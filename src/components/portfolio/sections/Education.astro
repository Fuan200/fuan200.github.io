---
interface Props {
    education: {
        institution: string;
        area: string;
        studyType: string;
        startDate: string;
        endDate: string;
        score?: number;
        faculty?: string;
        modules?: number;
        hours?: number;
    }[];
    languages: { language: string; fluency: string }[];
}

import Section from '@/components/Section.astro';

const { education, languages } = Astro.props;
const { currentLocale } = Astro;

const title = currentLocale === 'en' ? 'Education' : 'Educación';
const score_text = currentLocale === 'en' ? 'Score:' : 'Promedio de:';
const dateFormat = new Intl.DateTimeFormat(currentLocale === 'en' ? 'en' : 'es', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
});
---

<Section title={title}>
    <ul>
        {
            education.map(({ institution, startDate, endDate, area, score, modules, hours }) => {
                return (
                    <li>
                        <article>
                            <header>
                                <div>
                                    <h3>{area}</h3>
                                    <h4>{institution}</h4>
                                    {/* {faculty && <p>{faculty}</p>} */}
                                </div>
                                <div class='education-dates'>
                                    <time datetime={startDate}>{dateFormat.format(new Date(startDate))}</time>
                                    {' - '}
                                    <time datetime={endDate}>{dateFormat.format(new Date(endDate))}</time>
                                </div>
                            </header>
                            <footer>
                                {score !== undefined && (
                                    <p>
                                        <small>
                                            {score_text} {score}
                                        </small>
                                    </p>
                                )}
                                {(modules !== undefined || hours !== undefined) && (
                                    <p>
                                        <small>
                                            {[
                                                modules !== undefined ? `${modules} ${currentLocale === 'en' ? 'modules' : 'módulos'}` : '',
                                                hours !== undefined ? `${hours} ${currentLocale === 'en' ? 'hours' : 'horas'}` : '',
                                            ]
                                                .filter(Boolean)
                                                .join(' · ')}
                                        </small>
                                    </p>
                                )}
                            </footer>
                        </article>
                    </li>
                );
            })
        }
    </ul>
    <div class='languages'>
        <h3>{currentLocale === 'en' ? 'Languages' : 'Idiomas'}</h3>
        <div class='language-list'>
            {
                languages.map(({ language, fluency }) => (
                    <p class='language'>
                        <span>{language}</span>
                        <span>{fluency}</span>
                    </p>
                ))
            }
        </div>
    </div>
</Section>

<style>
    .education-dates time {
        text-transform: capitalize;
    }

    .languages {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid #303030;
    }

    .languages h3 {
        color: #fdfdfd;
        font-size: 1rem;
        font-weight: 500;
    }

    .language-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2.5rem;
        margin-top: 0.75rem;
    }

    .language {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        color: #bbb;
    }

    .language span:last-child {
        font-size: 0.85em;
    }

    article h4,
    .language {
        font-size: 1rem;
        font-weight: 400;
    }

    ul {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    article h3 {
        font-weight: 500;
        color: #fdfdfd;
        padding-bottom: 0.4rem;
    }

    article h4 {
        color: #bbb;
        font-weight: 400;
    }

    header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4px;
    }

    .education-dates {
        color: #bbb;
        font-size: 0.85rem;
        white-space: nowrap;
    }
</style>
