---
interface Props {
    education: {
        institution: string;
        area: string;
        studyType: string;
        startDate: string;
        endDate: string;
        score: number;
    }[];
    languages: { language: string; fluency: string }[];
}

import Section from '@/components/Section.astro';

const { education, languages } = Astro.props;
const { currentLocale } = Astro;

const title = currentLocale === 'en' ? 'Education' : 'Educación';
const score_text = currentLocale === 'en' ? 'Score:' : 'Promedio de:';
---

<Section title={title}>
    <ul>
        {
            education.map(({ institution, startDate, endDate, area, score }) => {
                const startYear = new Date(startDate).getFullYear();
                const endYear = endDate != null ? new Date(endDate).getFullYear() : 'Actual';
                const years = `${startYear} - ${endYear}`;
                return (
                    <li>
                        <article>
                            <header>
                                <div>
                                    <h3>{institution}</h3>
                                    <h4>{area}</h4>
                                </div>
                                <time>{years}</time>
                            </header>
                            <footer>
                                {/* <p>{studyType}</p> */}
                                <p>
                                    <small>
                                        {score_text} {score}
                                    </small>
                                </p>
                            </footer>
                        </article>
                    </li>
                );
            })
        }
    </ul>
    <div class='languages'>
        <h3>{currentLocale === 'en' ? 'Languages' : 'Idiomas'}</h3>
        <div class='language-list'>
            {
                languages.map(({ language, fluency }) => (
                    <p class='language'>
                        <span>{language}</span>
                        <span>{fluency}</span>
                    </p>
                ))
            }
        </div>
    </div>
</Section>

<style>
    .languages {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid #303030;
    }

    .languages h3 {
        color: #fdfdfd;
        font-size: 1rem;
        font-weight: 500;
    }

    .language-list {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2.5rem;
        margin-top: 0.75rem;
    }

    .language {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        color: #bbb;
    }

    .language span:last-child {
        font-size: 0.85em;
    }

    article h4,
    .language {
        font-size: 1rem;
        font-weight: 400;
    }

    ul {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    article h3 {
        font-weight: 500;
        color: #fdfdfd;
        padding-bottom: 0.4rem;
    }

    article h4 {
        color: #bbb;
        font-weight: 400;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4px;
    }

    time {
        color: #bbb;
        font-size: 0.85rem;
    }
</style>
