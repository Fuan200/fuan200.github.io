---
interface Props {
    basics: {
        name: string;
        label: string;
        image: string;
        location: {
            city: string;
            region: string;
        };
        profiles: {
            network: string;
            username: string;
            url: string;
        }[];
        phone: string;
        email: string;
        cv: string;
    };
}

import Section from '@/components/Section.astro';
import Mail from '@/icons/Mail.astro';
import Phone from '@/icons/Phone.astro';
import LinkedIn from '@/icons/LinkedIn.astro';
import GitHub from '@/icons/GitHub.astro';
import WorldMap from '@/icons/WorldMap.astro';
// import Translate from "@/icons/translate.astro"

const { currentLocale } = Astro;
const { basics } = Astro.props;
const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;
const download_cv = currentLocale === 'en' ? 'Download CV' : 'Descargar CV';

const SOCIAL_ICONS: Record<string, any> = {
    GitHub,
    LinkedIn,
};

// const toggleLanguage = currentLocale === "en" ? "/" : "/en";

const linkedInInfo = profiles.find(({ network }) => network === 'LinkedIn');
const linkedUrl = linkedInInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(' &bull; ');
---

<Section>
    <div class='container'>
        <div class='info'>
            <h1>{name}</h1>
            <h2>{label}</h2>
            <span>
                <WorldMap />
                {city},{region}
            </span>
            <footer class='print'>
                {printInfo}
            </footer>
            <footer class='no-print hero-actions'>
                {
                    email && (
                        <a
                            class='icon-link'
                            href={`mailto:${email}`}
                            title={`Enviar un correo electronico a ${name} al correo ${email}`}
                            aria-label={`Enviar un correo electronico a ${name}`}
                            target='_blank'
                            rel='noopener noreferrer'
                        >
                            <Mail />
                        </a>
                    )
                }
                {
                    phone && (
                        <a
                            class='icon-link'
                            href={`tel:${phone}`}
                            title={`Llamar a ${name} al número ${phone}`}
                            aria-label={`Llamar a ${name}`}
                            target='_blank'
                            rel='noopener noreferrer'
                        >
                            <Phone />
                        </a>
                    )
                }
                {
                    profiles.map(({ network, url }) => {
                        const Icon = SOCIAL_ICONS[network];

                        return (
                            <a
                                class='icon-link'
                                href={url}
                                title={`Visitar el perfil de ${name} en ${network}`}
                                aria-label={`Visitar el perfil de ${name} en ${network}`}
                                target='_blank'
                                rel='noopener noreferrer'
                            >
                                <Icon />
                            </a>
                        );
                    })
                }
                <!-- {
                    <a href={toggleLanguage}>
                        <Translate />
                    </a> 
                } -->
                {
                    basics.cv && (
                        <a href={basics.cv} download class='download-btn' title={`Descargar el CV de ${name}`}>
                            {download_cv}
                        </a>
                    )
                }
            </footer>
        </div>
        <figure>
            <img src={image} alt={name} />
        </figure>
    </div>
</Section>

<style>
    .hero-actions {
        --action-border: rgba(255, 255, 255, 0.16);
        --action-surface: rgba(255, 255, 255, 0.06);
        --action-surface-hover: #009196;
        --action-text: #f3f4f6;
        --action-muted: #c9d1d9;
        --action-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
        --action-highlight: #16c6c9;
    }

    .container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-right: 32px;
    }

    @media (max-width: 768px) {
        .container {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.5rem;
        }

        .info {
            padding-right: 0;
            align-items: center;
        }

        footer.no-print {
            justify-content: center;
        }

        img {
            width: 150px;
        }

        footer.no-print {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .hero-actions a:not(.download-btn) {
            order: 1;
            flex: 0 0 auto;
        }

        .hero-actions a.download-btn {
            order: 2;
            width: calc(100% - 32px);
            margin-top: 1rem;
            max-width: 17rem;
        }
    }

    h1 {
        font-size: 2.1rem;
        color: #fdfdfd;
    }

    h2 {
        color: #fdfdfd;
        font-weight: 500;
        font-size: 1.3rem;
        text-wrap: balance;
    }

    img {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        width: 128px;
        border-radius: 16px;
    }

    span {
        color: #bbb;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        letter-spacing: -0.01rem;
    }

    footer.no-print {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    footer {
        color: #fdfdfd;
        font-size: 0.65rem;
        display: flex;
        gap: 16px;
        margin-top: 8px;
    }

    .hero-actions a {
        color: var(--action-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--action-border);
        background: var(--action-surface);
        box-shadow: var(--action-shadow);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        text-decoration: none;
        transition:
            transform 0.22s ease,
            background-color 0.22s ease,
            border-color 0.22s ease,
            color 0.22s ease,
            box-shadow 0.22s ease;
    }

    .icon-link {
        padding: 6px;
        height: 42px;
        width: 42px;
        border-radius: 50%;
    }

    .download-btn {
        width: auto;
        min-width: 148px;
        min-height: 42px;
        padding: 0.8rem 1.15rem;
        border-radius: 999px;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        color: var(--action-text);
        text-align: center;
        background:
            linear-gradient(135deg, rgba(22, 198, 201, 0.28), rgba(84, 110, 255, 0.28)),
            rgba(255, 255, 255, 0.08);
    }

    .hero-actions a svg {
        width: 16px;
        height: 16px;
        transition:
            transform 0.22s ease,
            fill 0.22s ease;
    }

    .hero-actions a:hover {
        color: var(--action-text);
        border-color: rgba(255, 255, 255, 0.28);
        background: var(--action-surface-hover);
        transform: translateY(-2px);
        box-shadow: 0 16px 34px rgba(0, 0, 0, 0.22);
    }

    .hero-actions a:hover svg {
        fill: #fdfdfd;
        transform: scale(1.08);
    }

    .download-btn:hover {
        background: #009196;
        border-color: #009196;
        color: white;
    }

    .hero-actions a:focus-visible {
        outline: 2px solid var(--action-highlight);
        outline-offset: 3px;
        color: var(--action-text);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-actions a,
        .hero-actions a svg {
            transition: none;
        }
    }
</style>
