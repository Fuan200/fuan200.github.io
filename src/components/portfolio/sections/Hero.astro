---
interface Props {
    basics: {
        name: string;
        label: string;
        image: string;
        location: {
            city: string;
            region: string;
        };
        profiles: {
            network: string;
            username: string;
            url: string;
        }[];
        phone: string;
        email: string;
        cv: string;
    };
}

import Section from '@/components/Section.astro';
import Mail from '@/icons/Mail.astro';
import Phone from '@/icons/Phone.astro';
import LinkedIn from '@/icons/LinkedIn.astro';
import GitHub from '@/icons/GitHub.astro';
import WorldMap from '@/icons/WorldMap.astro';
// import Translate from "@/icons/translate.astro"

const { currentLocale } = Astro;
const { basics } = Astro.props;
const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;
const download_cv = currentLocale === 'en' ? 'Download CV' : 'Descargar CV';

const SOCIAL_ICONS: Record<string, any> = {
    GitHub,
    LinkedIn,
};

// const toggleLanguage = currentLocale === "en" ? "/" : "/en";

const linkedInInfo = profiles.find(({ network }) => network === 'LinkedIn');
const linkedUrl = linkedInInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(' &bull; ');
---

<Section>
    <div class='container'>
        <div class='info'>
            <h1>{name}</h1>
            <h2>{label}</h2>
            <span>
                <WorldMap />
                {city},{region}
            </span>
            <footer class='print'>
                {printInfo}
            </footer>
            <footer class='no-print hero-actions'>
                {
                    email && (
                        <a
                            class='icon-link'
                            href={`mailto:${email}`}
                            title={`Enviar un correo electronico a ${name} al correo ${email}`}
                            aria-label={`Enviar un correo electronico a ${name}`}
                            target='_blank'
                            rel='noopener noreferrer'
                        >
                            <Mail />
                        </a>
                    )
                }
                {
                    phone && (
                        <a
                            class='icon-link'
                            href={`tel:${phone}`}
                            title={`Llamar a ${name} al número ${phone}`}
                            aria-label={`Llamar a ${name}`}
                            target='_blank'
                            rel='noopener noreferrer'
                        >
                            <Phone />
                        </a>
                    )
                }
                {
                    profiles.map(({ network, url }) => {
                        const Icon = SOCIAL_ICONS[network];

                        return (
                            <a
                                class='icon-link'
                                href={url}
                                title={`Visitar el perfil de ${name} en ${network}`}
                                aria-label={`Visitar el perfil de ${name} en ${network}`}
                                target='_blank'
                                rel='noopener noreferrer'
                            >
                                <Icon />
                            </a>
                        );
                    })
                }
                <!-- {
                    <a href={toggleLanguage}>
                        <Translate />
                    </a> 
                } -->
                {
                    basics.cv && (
                        <a
                            href={basics.cv}
                            download
                            class='download-btn'
                            title={currentLocale === 'en' ? `Download ${name}'s CV` : `Descargar el CV de ${name}`}
                        >
                            {download_cv}
                        </a>
                    )
                }
            </footer>
        </div>
        <figure>
            <img src={image} alt={name} />
        </figure>
    </div>
</Section>

<style>
    .hero-actions {
        --action-border: #333;
        --action-surface: #222;
        --action-surface-hover: #009196;
        --action-text: #f3f4f6;
        --action-muted: #bbb;
        --action-highlight: #16c6c9;
    }

    .container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-right: 32px;
    }

    @media (max-width: 768px) {
        .container {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.5rem;
        }

        .info {
            padding-right: 0;
            align-items: center;
        }

        footer.no-print {
            justify-content: center;
        }

        img {
            width: 150px;
        }

        footer.no-print {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .hero-actions a:not(.download-btn) {
            order: 1;
            flex: 0 0 auto;
        }

        .hero-actions a.download-btn {
            order: 2;
            width: calc(100% - 32px);
            margin-inline-start: 0;
            margin-top: 0.5rem;
            max-width: 17rem;
        }
    }

    h1 {
        font-size: 2.1rem;
        color: #fdfdfd;
    }

    h2 {
        color: #fdfdfd;
        font-weight: 500;
        font-size: 1.3rem;
        text-wrap: balance;
    }

    img {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        width: 128px;
        border-radius: 16px;
    }

    span {
        color: #bbb;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        letter-spacing: -0.01rem;
    }

    footer.no-print {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }

    footer {
        color: #fdfdfd;
        font-size: 0.65rem;
        display: flex;
        gap: 16px;
        margin-top: 8px;
    }

    .hero-actions a {
        color: var(--action-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid transparent;
        background: var(--action-surface);
        text-decoration: none;
        transition:
            transform 0.22s ease,
            background-color 0.22s ease,
            border-color 0.22s ease,
            color 0.22s ease;
    }

    .icon-link {
        padding: 8px;
        height: 44px;
        width: 44px;
        box-sizing: border-box;
        border-radius: 14px;
        flex-shrink: 0;
    }

    .hero-actions .download-btn {
        width: auto;
        min-height: 46px;
        box-sizing: border-box;
        margin-inline-start: 14px;
        padding: 0.65rem 1rem;
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 400;
        letter-spacing: 0.01em;
        text-align: center;
        border-color: var(--action-border);
        background: transparent;
    }

    .icon-link :global(svg) {
        width: 22px;
        height: 22px;
    }

    .hero-actions a:hover {
        color: var(--action-text);
        border-color: var(--action-surface-hover);
        background: var(--action-surface-hover);
        transform: translateY(-1px);
    }

    .hero-actions a:focus-visible {
        outline: 2px solid var(--action-highlight);
        outline-offset: 3px;
        color: var(--action-text);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-actions a {
            transition: none;
        }
    }
</style>
