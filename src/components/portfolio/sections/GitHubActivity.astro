---
import Section from '@/components/Section.astro';

interface Props {
    profiles: { network: string; username: string; url: string }[];
}

interface Contribution {
    date: string;
    count: number;
    level: number;
}

const { profiles } = Astro.props;
const github = profiles.find(({ network }) => network === 'GitHub');
const isEnglish = Astro.currentLocale === 'en';
const title = isEnglish ? 'GitHub Activity' : 'Actividad en GitHub';
const caption = isEnglish ? 'Contributions in the past year' : 'Contribuciones durante el último año';
let totalContributions: number | undefined;
let contributions: Contribution[] = [];
const colors = [
    '#202426',
    'color-mix(in srgb, var(--activity-color) 25%, #202426)',
    'color-mix(in srgb, var(--activity-color) 50%, #202426)',
    'color-mix(in srgb, var(--activity-color) 75%, #202426)',
    'var(--activity-color)',
];

if (github) {
    try {
        const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(github.username)}?y=last`, {
            signal: AbortSignal.timeout(5000),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        const total = data.total?.lastYear;
        if (!Number.isSafeInteger(total) || total < 0) throw new Error('Invalid contribution total');
        totalContributions = total;
        if (
            Array.isArray(data.contributions) &&
            data.contributions.every(
                (day: Contribution) =>
                    /^\d{4}-\d{2}-\d{2}$/.test(day?.date) &&
                    Number.isFinite(Date.parse(day.date)) &&
                    Number.isSafeInteger(day.count) &&
                    day.count >= 0 &&
                    Number.isInteger(day.level) &&
                    day.level >= 0 &&
                    day.level < colors.length,
            )
        )
            contributions = data.contributions;
    } catch (error) {
        console.warn('Could not load GitHub contribution total:', error);
    }
}
const firstWeekday = contributions.length ? new Date(`${contributions[0].date}T00:00:00Z`).getUTCDay() : 0;
const calendarWidth = Math.ceil((contributions.length + firstWeekday) / 7) * 14;
const monthFormat = new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', { month: 'short', timeZone: 'UTC' });
const dateFormat = new Intl.DateTimeFormat(isEnglish ? 'en' : 'es', { dateStyle: 'medium', timeZone: 'UTC' });
---

{
    github && (
        <Section title={title}>
            <figure class='activity-card'>
                <div class='calendar-scroll' role='region' aria-label={caption} tabindex='0'>
                    <a href={github.url} target='_blank' rel='noopener noreferrer'>
                        {contributions.length > 0 ? (
                            <svg class='calendar' viewBox={`0 0 ${calendarWidth} 114`} role='group' aria-label={`${caption}: ${github.username}`}>
                                {contributions.map((day, index) => {
                                    const column = Math.floor((index + firstWeekday) / 7);
                                    const row = (index + firstWeekday) % 7;
                                    const date = dateFormat.format(new Date(`${day.date}T00:00:00Z`));
                                    const contributionLabel = isEnglish
                                        ? `${day.count} ${day.count === 1 ? 'contribution' : 'contributions'} on ${date}`
                                        : `${day.count} ${day.count === 1 ? 'contribución' : 'contribuciones'} el ${date}`;
                                    return (
                                        <>
                                            {day.date.endsWith('-01') && (
                                                <text x={column * 14} y='10'>
                                                    {monthFormat.format(new Date(`${day.date}T00:00:00Z`))}
                                                </text>
                                            )}
                                            <rect
                                                x={column * 14}
                                                y={18 + row * 14}
                                                width='11'
                                                height='11'
                                                rx='3.5'
                                                fill='#202426'
                                                aria-hidden='true'
                                                pointer-events='none'
                                            />
                                            <rect
                                                x={column * 14}
                                                y={18 + row * 14}
                                                width='11'
                                                height='11'
                                                rx='3.5'
                                                fill={colors[day.level]}
                                                style={`animation-delay: ${column * 25}ms`}
                                                aria-label={contributionLabel}
                                                data-contribution={contributionLabel}
                                                tabindex='0'
                                                role='img'
                                            />
                                        </>
                                    );
                                })}
                            </svg>
                        ) : (
                            <img
                                src={`https://ghchart.rshah.org/${encodeURIComponent(github.username)}`}
                                alt={`${caption}: ${github.username}`}
                                width='722'
                                height='112'
                                loading='lazy'
                                decoding='async'
                            />
                        )}
                    </a>
                </div>
                <figcaption>
                    <span>
                        {totalContributions !== undefined && <strong>{totalContributions.toLocaleString(isEnglish ? 'en' : 'es')} </strong>}
                        {totalContributions !== undefined ? caption.toLowerCase() : caption}
                    </span>
                    <span
                        class='legend'
                        aria-label={isEnglish ? 'Contribution intensity: less to more' : 'Intensidad de contribuciones: de menos a más'}
                    >
                        <span>{isEnglish ? 'Less' : 'Menos'}</span>
                        <svg width='56' height='8' viewBox='0 0 56 8' aria-hidden='true'>
                            {colors.map((color, index) => (
                                <rect x={index * 12} width='8' height='8' rx='2' fill={color} />
                            ))}
                        </svg>
                        <span>{isEnglish ? 'More' : 'Más'}</span>
                    </span>
                </figcaption>
                <div class='contribution-tooltip' role='tooltip' />
            </figure>
        </Section>
    )
}

<script>
    function initializeContributionTooltips() {
        document.querySelectorAll<HTMLElement>('.activity-card').forEach((card) => {
            if (card.dataset.tooltipBound) return;
            const tooltip = card.querySelector<HTMLElement>('.contribution-tooltip');
            if (!tooltip) return;
            card.dataset.tooltipBound = 'true';

            const hide = () => {
                delete tooltip.dataset.visible;
            };
            const show = (event: Event) => {
                const cell = event.target;
                if (!(cell instanceof SVGRectElement) || !cell.dataset.contribution) return;
                const isEntering = !tooltip.dataset.visible;
                if (isEntering) tooltip.style.transition = 'none';
                tooltip.textContent = cell.dataset.contribution;
                const bounds = cell.getBoundingClientRect();
                const width = tooltip.offsetWidth;
                const left = Math.max(8, Math.min(bounds.left + bounds.width / 2 - width / 2, window.innerWidth - width - 8));
                tooltip.style.left = `${left}px`;
                tooltip.style.top = `${Math.max(8, bounds.top - tooltip.offsetHeight - 8)}px`;
                if (isEntering) {
                    // Commit the hidden position before starting the scale-in animation.
                    void tooltip.offsetWidth;
                    tooltip.style.removeProperty('transition');
                }
                tooltip.dataset.visible = 'true';
            };

            card.addEventListener('pointerover', show);
            card.querySelector('.calendar')?.addEventListener('pointerleave', hide);
            card.addEventListener('focusin', show);
            card.addEventListener('focusout', hide);
            card.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') hide();
            });
            window.addEventListener('scroll', hide, { passive: true });
            window.addEventListener('resize', hide);
        });
    }

    initializeContributionTooltips();
    document.addEventListener('astro:page-load', initializeContributionTooltips);
</script>

<style>
    .contribution-tooltip {
        position: fixed;
        z-index: 100;
        max-width: calc(100vw - 16px);
        box-sizing: border-box;
        padding: 0.45rem 0.65rem;
        border-radius: 7px;
        background: #f5f5f5;
        color: #161616;
        font-size: 0.75rem;
        line-height: 1.4;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px) scale(0.7);
        transform-origin: bottom center;
        transition:
            opacity 400ms ease,
            transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
            left 400ms ease,
            top 400ms ease,
            visibility 400ms;
    }

    .contribution-tooltip[data-visible] {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    .contribution-tooltip::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: #f5f5f5;
    }

    @media (prefers-reduced-motion: reduce) {
        .contribution-tooltip {
            transition: none;
            transform: none;
        }
    }

    .activity-card {
        --activity-color: var(--color-primary);
        margin: 1rem 0 0;
        padding: 1.25rem;
        border: 1px solid #282828;
        border-radius: 20px;
        background: #101010;
    }

    .calendar-scroll a {
        display: block;
    }

    img,
    .calendar {
        display: block;
        width: 100%;
        height: auto;
    }

    img {
        filter: invert(1) hue-rotate(180deg);
    }

    .calendar text {
        fill: #aaa;
        font-size: 10px;
    }

    .calendar rect[data-contribution] {
        animation: reveal-contribution 250ms ease both;
    }

    @keyframes reveal-contribution {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .calendar rect[data-contribution] {
            animation: none;
        }
    }

    figcaption {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
        color: #aaa;
        font-size: 0.75rem;
    }

    .legend {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }

    .calendar rect:focus-visible {
        stroke: #fff;
        stroke-width: 1;
    }

    a:focus-visible,
    .calendar-scroll:focus-visible {
        outline: 2px solid #16c6c9;
        outline-offset: 3px;
    }
</style>
