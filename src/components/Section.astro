---
interface Props {
    title?: string;
    maxWidth?: string;
}

const { title, maxWidth = '700px' } = Astro.props;
---

<section style={`max-width: ${maxWidth};`}>
    {title && <h2>{title}</h2>}
    <slot />
</section>

<style>
    section {
        margin: 0 auto 48px;
        background: #121212;
        border-radius: 8px;
        padding: 16px;
    }

    h2 {
        margin-bottom: 8px;
        font-weight: 700;
        line-height: 1.5;
        font-size: 1.5rem;
        color: #ffffff;
    }
</style>
